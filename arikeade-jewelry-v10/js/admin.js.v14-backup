const API_BASE=(window.ARIKADE_CONFIG?.API_BASE_URL||"").replace(/\/$/,"");
const TOKEN_KEY="arikeade-admin-token";
const seedKey="arikeade-products";
const money=v=>new Intl.NumberFormat("en-NG",{style:"currency",currency:"NGN",maximumFractionDigits:0}).format(Number(v)||0);
const read=(key,fallback)=>{try{const x=JSON.parse(localStorage.getItem(key)||"null");return x??fallback}catch{return fallback}};
const seed=()=>[{id:"ARI-001",name:"Gold Pearl Necklace",category:"Necklaces",price:85000,material:"18K Gold Plated",stock:12,rating:4.9,featured:true,theme:"",image:"https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=900&q=85",description:"A refined pearl necklace designed for effortless elegance, with a warm gold finish that works from day to evening.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-002",name:"Classic Gold Hoops",category:"Earrings",price:45000,material:"18K Gold Plated",stock:8,rating:4.8,featured:true,theme:"rose",image:"https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=900&q=85",description:"Polished everyday hoops with a balanced silhouette and lightweight feel.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-003",name:"Sculpted Signet Ring",category:"Rings",price:62000,material:"Stainless Steel Gold Finish",stock:5,rating:4.7,featured:true,theme:"dark",image:"https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=900&q=85",description:"A modern signet-inspired ring with a clean sculpted face.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-004",name:"Luna Tennis Bracelet",category:"Bracelets",price:125000,material:"Gold Tone + Crystal",stock:4,rating:4.9,featured:true,theme:"",image:"https://images.unsplash.com/photo-1611652022419-a9419f74343d?auto=format&fit=crop&w=900&q=85",description:"A luminous tennis bracelet designed to catch the light with every movement.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-005",name:"Pearl Drop Earrings",category:"Earrings",price:55000,material:"Freshwater Pearl",stock:9,rating:4.6,featured:false,theme:"rose",image:"https://images.unsplash.com/photo-1535632787350-4e68ef0ac584?auto=format&fit=crop&w=900&q=85",description:"Soft pearl drops with a graceful profile for weddings, dinners and special occasions.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-006",name:"Minimal Gold Chain",category:"Necklaces",price:72000,material:"18K Gold Plated",stock:15,rating:4.8,featured:true,theme:"dark",image:"https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=900&q=85",description:"A versatile fine chain made for layering or wearing alone.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-007",name:"Aurelia Cuff",category:"Bracelets",price:98000,material:"Gold Plated Brass",stock:6,rating:4.7,featured:false,theme:"",image:"https://images.unsplash.com/photo-1573408301185-9146fe634ad0?auto=format&fit=crop&w=900&q=85",description:"A structured cuff with a softly brushed finish and contemporary lines.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]},{id:"ARI-008",name:"Halo Crystal Ring",category:"Rings",price:68000,material:"Gold Tone + Crystal",stock:3,rating:4.9,featured:false,theme:"rose",image:"https://images.unsplash.com/photo-1603561596112-db6e1e7d3d7a?auto=format&fit=crop&w=900&q=85",description:"A delicate halo silhouette with a luminous centre stone.",salePrice:0,newArrival:false,sale:false,active:true,size:"",gallery:[]}];
let products=read(seedKey,null);if(!Array.isArray(products)||!products.length){products=seed();persist()}
let selectedImages=[];let editingId=null;
const $=s=>document.querySelector(s);
const els={form:$("#productForm"),id:$("#productId"),name:$("#name"),sku:$("#sku"),category:$("#category"),price:$("#price"),salePrice:$("#salePrice"),stock:$("#stock"),material:$("#material"),rating:$("#rating"),size:$("#size"),description:$("#description"),imageUrl:$("#imageUrl"),featured:$("#featured"),newArrival:$("#newArrival"),sale:$("#sale"),active:$("#active"),input:$("#imageInput"),preview:$("#imagePreview"),count:$("#imageCount"),list:$("#catalogList"),productCount:$("#productCount"),search:$("#catalogSearch"),filter:$("#catalogFilter"),error:$("#formError"),title:$("#formTitle"),saveLabel:$("#saveLabel"),cancel:$("#cancelEdit"),toast:$("#toast"),status:$("#apiStatus"),loginPanel:$("#loginPanel"),loginForm:$("#loginForm"),loginEmail:$("#loginEmail"),loginPassword:$("#loginPassword"),loginError:$("#loginError"),logout:$("#logoutButton")};
function persist(){try{localStorage.setItem(seedKey,JSON.stringify(products));return true}catch{notify("Catalog is too large for this browser. V13 API mode avoids storing product photos locally.");return false}}
function notify(msg){els.toast.textContent=msg;els.toast.classList.add("show");clearTimeout(notify.t);notify.t=setTimeout(()=>els.toast.classList.remove("show"),2600)}
function escapeHtml(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[m]))}
function authToken(){return localStorage.getItem(TOKEN_KEY)||""}
async function api(path,options={}){const headers={"Content-Type":"application/json",...(options.headers||{})};const token=authToken();if(token)headers.Authorization=`Bearer ${token}`;const r=await fetch(`${API_BASE}${path}`,{...options,headers});let data={};try{data=await r.json()}catch{}if(!r.ok)throw new Error(data.message||`Request failed (${r.status})`);return data}
async function login(){if(!API_BASE)return true;els.loginError.textContent="";try{const data=await api("/auth/login",{method:"POST",headers:{},body:JSON.stringify({email:els.loginEmail.value.trim(),password:els.loginPassword.value})});localStorage.setItem(TOKEN_KEY,data.token);els.loginPanel.classList.add("hidden");els.logout.classList.remove("hidden");setStatus(true);await loadProducts();notify("Signed in to the shared catalog.");return true}catch(e){els.loginError.textContent=e.message;return false}}
function setStatus(live){els.status.textContent=live?"API CONNECTED":"LOCAL MODE";els.status.classList.toggle("live",live)}
async function loadProducts(){if(!API_BASE)return;const data=await api("/products?includeHidden=true");products=(data.products||[]).map(normalize);persist();renderList()}
function normalize(p){return {...p,id:p.sku||p.id,gallery:Array.isArray(p.gallery)?p.gallery:[],salePrice:Number(p.salePrice||0),price:Number(p.price||0),stock:Number(p.stock||0)}}
async function bootApi(){if(!API_BASE){setStatus(false);return}setStatus(false);els.logout.classList.remove("hidden");if(!authToken()){els.loginPanel.classList.remove("hidden");return}try{await api("/auth/me");setStatus(true);await loadProducts()}catch{localStorage.removeItem(TOKEN_KEY);els.loginPanel.classList.remove("hidden")}}
function renderList(){const q=els.search.value.trim().toLowerCase(),filter=els.filter.value;const shown=products.filter(p=>(filter==="All"||(filter==="Active"?p.active:!p.active))&&(!q||`${p.name} ${p.id} ${p.category} ${p.material}`.toLowerCase().includes(q)));els.productCount.textContent=products.length;els.list.innerHTML=shown.length?shown.map(p=>`<article class="catalog-item"><div class="catalog-thumb"><img src="${escapeHtml(p.image)}" alt="${escapeHtml(p.name)}" loading="lazy"></div><div class="catalog-info"><strong>${escapeHtml(p.name)}</strong><span>${escapeHtml(p.id)} · ${escapeHtml(p.category)} · ${escapeHtml(p.material)}</span><div class="catalog-price">${money(p.salePrice||p.price)} ${p.salePrice?`<del>${money(p.price)}</del>`:""} · ${p.stock} in stock</div><span class="status ${p.active?"":"hidden-status"}">${p.active?"Live":"Hidden"}</span></div><div class="catalog-actions-row"><button class="mini-btn" data-edit="${escapeHtml(p.id)}">EDIT</button><button class="mini-btn danger" data-delete="${escapeHtml(p.id)}">DELETE</button></div></article>`).join(""):`<div class="empty-list">No products match this filter.</div>`}
function preview(){els.count.textContent=`${selectedImages.length} / 4`;els.preview.innerHTML=selectedImages.map((src,i)=>`<div class="preview"><img src="${src}" alt="Product photo ${i+1}"><button type="button" data-remove-image="${i}" aria-label="Remove image">×</button>${i===0?"<span>PRIMARY</span>":""}</div>`).join("")}
function compress(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>{const img=new Image();img.onload=()=>{const max=1400,scale=Math.min(1,max/Math.max(img.width,img.height)),c=document.createElement("canvas");c.width=Math.round(img.width*scale);c.height=Math.round(img.height*scale);c.getContext("2d").drawImage(img,0,0,c.width,c.height);resolve(c.toDataURL("image/jpeg",.82))};img.onerror=reject;img.src=r.result};r.onerror=reject;r.readAsDataURL(file)})}
async function addFiles(files){const available=4-selectedImages.length;for(const f of [...files].slice(0,available)){if(!f.type.startsWith("image/"))continue;try{selectedImages.push(await compress(f))}catch{notify("One image could not be processed.")}}preview()}
function resetForm(){editingId=null;els.form.reset();els.id.value="";els.rating.value="5";els.active.checked=true;selectedImages=[];preview();els.title.textContent="Add Product";els.saveLabel.textContent="SAVE PRODUCT";els.cancel.classList.add("hidden");els.error.textContent=""}
function fill(p){editingId=p.id;els.id.value=p.id;els.name.value=p.name;els.sku.value=p.id;els.category.value=p.category;els.price.value=p.price;els.salePrice.value=p.salePrice||"";els.stock.value=p.stock;els.material.value=p.material;els.rating.value=p.rating??5;els.size.value=p.size||"";els.description.value=p.description||"";els.imageUrl.value=p.image||"";els.featured.checked=!!p.featured;els.newArrival.checked=!!p.newArrival;els.sale.checked=!!p.sale;els.active.checked=p.active!==false;selectedImages=[...(p.gallery&&p.gallery.length?p.gallery:[p.image]).filter(Boolean)].slice(0,4);preview();els.title.textContent="Edit Product";els.saveLabel.textContent="UPDATE PRODUCT";els.cancel.classList.remove("hidden");window.scrollTo({top:0,behavior:"smooth"})}
function collect(){const gallery=selectedImages.length?selectedImages:(editingId?(products.find(p=>p.id===editingId)?.gallery||[]):[]);const primary=API_BASE?(els.imageUrl.value.trim()||gallery[0]||""):(gallery[0]||els.imageUrl.value.trim()||"");return {sku:editingId||els.sku.value.trim().toUpperCase(),name:els.name.value.trim(),category:els.category.value,price:Number(els.price.value),salePrice:Number(els.salePrice.value||0),stock:Number(els.stock.value),material:els.material.value.trim(),rating:Number(els.rating.value||5),size:els.size.value.trim(),description:els.description.value.trim(),featured:els.featured.checked,newArrival:els.newArrival.checked,sale:els.sale.checked,active:els.active.checked,image:primary,gallery:[primary,...gallery.filter(x=>x!==primary)].slice(0,8),theme:""}}
async function saveProduct(e){e.preventDefault();els.error.textContent="";if(!els.form.checkValidity()){els.form.reportValidity();return}const data=collect();if(data.salePrice&&data.salePrice>=data.price){els.error.textContent="Sale price must be lower than the regular price.";return}if(!data.image){els.error.textContent=API_BASE?"V13 API mode requires an image URL. Cloud image upload is the next V14 phase.":"Please upload at least one product photo.";return}try{if(API_BASE){const body={...data};if(body.image.startsWith("data:")){els.error.textContent="For shared API mode, use an image URL until Cloudinary is connected in V14.";return}const result=editingId?await api(`/products/${encodeURIComponent(editingId)}`,{method:"PUT",body:JSON.stringify(body)}):await api("/products",{method:"POST",body:JSON.stringify(body)});const p=normalize(result.product);products=editingId?products.map(x=>x.id===editingId?p:x):[p,...products];persist();notify(editingId?"Product updated on the shared catalog.":"Product added to the shared catalog.")}else{const old=products.find(p=>p.id===editingId);if(products.some(p=>p.id===data.sku&&p.id!==editingId)){els.error.textContent="That SKU already exists. Use a unique SKU.";return}const p={...data,id:data.sku,theme:old?.theme||""};products=editingId?products.map(x=>x.id===editingId?p:x):[p,...products];persist();notify(editingId?"Product updated successfully.":"Product added to the browser catalog.")}renderList();resetForm()}catch(err){els.error.textContent=err.message}}
async function deleteProduct(id){if(!confirm(`Delete ${id}?`))return;try{if(API_BASE)await api(`/products/${encodeURIComponent(id)}`,{method:"DELETE"});products=products.filter(p=>p.id!==id);persist();renderList();notify("Product deleted.")}catch(e){notify(e.message)}}
function exportCatalog(){const blob=new Blob([JSON.stringify(products,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="arikeade-products.json";a.click();URL.revokeObjectURL(a.href)}
function importCatalog(file){const r=new FileReader();r.onload=async()=>{try{const data=JSON.parse(r.result);if(!Array.isArray(data)||!data.length)throw Error();if(API_BASE){for(const item of data){const body={...item,sku:item.sku||item.id,image:item.image||item.gallery?.[0]};if(!body.image||String(body.image).startsWith("data:"))continue;try{await api(`/products/${encodeURIComponent(body.sku)}`,{method:"PUT",body:JSON.stringify(body)})}catch{await api("/products",{method:"POST",body:JSON.stringify(body)})}}await loadProducts();notify(`${products.length} products synced.`)}else{products=data;persist();renderList();notify(`${products.length} products imported.`)}}catch{notify("Import failed. Please select a valid Arikeade product JSON file.")}};r.readAsText(file)}
els.form.addEventListener("submit",saveProduct);els.input.addEventListener("change",e=>addFiles(e.target.files));$("#dropzone").addEventListener("dragover",e=>{e.preventDefault();$("#dropzone").classList.add("dragging")});$("#dropzone").addEventListener("dragleave",()=>$("#dropzone").classList.remove("dragging"));$("#dropzone").addEventListener("drop",e=>{e.preventDefault();$("#dropzone").classList.remove("dragging");addFiles(e.dataTransfer.files)});els.preview.addEventListener("click",e=>{const b=e.target.closest("[data-remove-image]");if(b){selectedImages.splice(Number(b.dataset.removeImage),1);preview()}});els.cancel.onclick=resetForm;els.search.oninput=renderList;els.filter.onchange=renderList;$("#exportCatalog").onclick=exportCatalog;$("#importCatalog").onchange=e=>{if(e.target.files[0])importCatalog(e.target.files[0]);e.target.value=""};els.list.addEventListener("click",e=>{const edit=e.target.closest("[data-edit]"),del=e.target.closest("[data-delete]");if(edit){const p=products.find(x=>x.id===edit.dataset.edit);if(p)fill(p)}if(del)deleteProduct(del.dataset.delete)});els.loginForm?.addEventListener("submit",e=>{e.preventDefault();login()});els.logout?.addEventListener("click",()=>{localStorage.removeItem(TOKEN_KEY);location.reload()});$("#resetCatalog").onclick=()=>{if(API_BASE){notify("Demo reset is disabled in API mode. Manage products through the shared database.");return}if(confirm("Reset this browser to the demo catalog? Your added products will be removed.")){localStorage.removeItem(seedKey);location.reload()}};renderList();bootApi();
